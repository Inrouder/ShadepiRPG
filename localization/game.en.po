msgid "RAVEN"
msgstr "RAVEN"

#: scripts/campaign.gd:952
msgid "Diese Stille … Nach der Stadt ist das fast unwirklich."
msgstr "It's so quiet… After the city, this almost doesn't feel real."

#: scripts/campaign.gd:953 scripts/campaign.gd:955 scripts/campaign.gd:957 scripts/campaign.gd:959 scripts/campaign.gd:961 scripts/campaign.gd:1348 scripts/campaign.gd:1349 scripts/campaign.gd:1365 scripts/campaign.gd:1399 scripts/campaign.gd:1406 scripts/campaign.gd:1412 scripts/campaign.gd:1460 scripts/campaign.gd:1474 scripts/campaign.gd:1476 scripts/campaign.gd:1480 scripts/campaign.gd:1482 scripts/campaign.gd:1579 scripts/campaign.gd:1668 scripts/campaign.gd:1670 scripts/chapter_one.gd:640 scripts/chapter_one.gd:653 scripts/chapter_one.gd:716 scripts/chapter_one.gd:718 scripts/chapter_one.gd:731 scripts/chapter_two.gd:659 scripts/chapter_two.gd:716 scripts/chapter_two.gd:739 scripts/chapter_two.gd:740 scripts/chapter_two.gd:766 scripts/chapter_two.gd:768 scripts/chapter_two.gd:770 scripts/chapter_two.gd:773 scripts/chapter_two.gd:774 scripts/hud.gd:215 scripts/hud.gd:396 scripts/hud.gd:821 scripts/chapter_one_intro.gd:124 scripts/chapter_one_intro.gd:126 scripts/chapter_one_intro.gd:128 scripts/chapter_one_intro.gd:130 scripts/chapter_one_intro.gd:256 scripts/sanctuary_story.gd:128 scripts/sanctuary_story.gd:132 scripts/sanctuary_story.gd:185 scripts/sanctuary_story.gd:189 scripts/sanctuary_story.gd:193 scripts/sanctuary_story.gd:197 scripts/sanctuary_story.gd:203 scripts/sanctuary_story.gd:207 scripts/sanctuary_story.gd:209 scripts/outbound_flight.gd:41 scripts/outbound_flight.gd:93 scripts/tower_escape.gd:185 scripts/tower_escape.gd:209 scripts/ice_bath_sequence.gd:155 scripts/ice_bath_sequence.gd:208 scripts/ice_bath_sequence.gd:237 scripts/hangar_discovery.gd:101 scripts/hangar_discovery.gd:161 scripts/hangar_discovery.gd:161 scripts/hangar_discovery.gd:161 scripts/cutscene.gd:18 scripts/tower_story.gd:98 scripts/tower_story.gd:120 scripts/tower_story.gd:138 scripts/tower_story.gd:141 scripts/tower_story.gd:166 scripts/tower_story.gd:170 scripts/lake_sequence.gd:339 scripts/lake_sequence.gd:369 scripts/lake_sequence.gd:369 scripts/hangar_departure.gd:112 sc