#: scripts/campaign.gd:258
msgid "WACHEN IM WEG · alle ausschalten"
msgstr "GUARDS BLOCKING THE WAY · take them all out"

#: scripts/campaign.gd:260
msgid "Weiter zu Kenzōs Penthouse →"
msgstr "On to Kenzō's penthouse →"

#: scripts/campaign.gd:260
msgid "Zum Landeplatz ←"
msgstr "To the landing pad ←"

#: scripts/campaign.gd:305
msgid "Weg frei · zum Landeplatz ←"
msgstr "Path clear · to the landing pad ←"

#: scripts/campaign.gd:305
msgid "Lobby frei · weiter in den Flur ←"
msgstr "Lobby clear · into the corridor ←"

#: scripts/campaign.gd:309
msgid "Zeit abgelaufen · Kontrollpunkt"
msgstr "Time's up · checkpoint"

#: scripts/campaign.gd:561
msgid "Landung abgebrochen · Kontrollpunkt"
msgstr "Landing aborted · checkpoint"

#: scripts/campaign.gd:561
msgid "Fahrzeug ausgefallen · Kontrollpunkt"
msgstr "Vehicle disabled · checkpoint"

#: scripts/campaign.gd:644
msgid "ALLE ABSCHNITTE FREI · Zum Motorrad →"
msgstr "ALL SECTIONS CLEAR · To the motorcycle →"

#: scripts/campaign.gd:654
msgid "TRUPPFÜHRER · Schild vorn – von hinten treffen oder Ravens Hack nutzen"
msgstr "SQUAD LEADER · Frontal shield – strike from behind or use Raven's hack"

#: scripts/campaign.gd:710
msgid "Raven extrahiert Daten · Shadepi muss die Wachen abfangen"
msgstr "Raven is extracting data · Shadepi must intercept the guards"

#: scripts/campaign.gd:715
msgid "Ravens Deck lädt."
msgstr "Raven's deck is recharging."

#: scripts/campaign.gd:725
msgid "Raven braucht eine freie Verbindung."
msgstr "Raven needs a clear connection."

#: scripts/campaign.gd:728
msgid "Kenzō sperrt die Leitung. Auf das Flackern am Schulterservo warten."
msgstr "Kenzō is blocking the link. Wait for his shoulder servo to flicker."

#: scripts/campaign.gd:734
msgid "Optik und Implantate gestört."
msgstr "Optics and implants disrupted."

#: scripts/campaign.gd:745
msgid "Die Gasse ist frei. Zum Motorrad!"
msgstr "The alley's clear. To the bike!"

#: scripts/campaign.gd:759
msgid "Systemausfall · Kontrollpunkt"
msgstr "System failure · checkpoint"

#: scripts/campaign.gd:764
msgid "KAPITEL 5 / HEILIGTUM"
msgstr "CHAPTER 5 / SANCTUARY"

#: scripts/campaign.gd:766
msgid "KAPITEL 4 / DRACHENHÖHLE"
msgstr "CHAPTER 4 / DRAGON'S DEN"

#: scripts/campaign.gd:799
msgid "Wachen ausschalten · %d übrig"
msgstr "Eliminate the guards · %d left"

#: scripts/campaign.gd:800
msgid "Durch den Flur zu Kenzōs Penthouse"
msgstr "Through the corridor to Kenzō's penthouse"

#: scripts/campaign.gd:800
msgid "Zurück zum Landeplatz"
msgstr "Back to the landing pad"

#: scripts/campaign.gd:806
msgid "Hinterhalt · %d Gegner"
msgstr "Ambush · %d enemies"

#: scripts/campaign.gd:806
msgid "Zum Motorrad"
msgstr "To the motorcycle"

#: scripts/campaign.gd:808
msgid "Erinnerungen ordnen · %d / 3"
msgstr "Piece together the memories · %d / 3"

#: scripts/campaign.gd:808
msgid "Raven: Am Bett ausruhen"
msgstr "Raven: Rest on the bed"

#: scripts/campaign.gd:808
msgid "Raven: Durch die Tür nachsehen"
msgstr "Raven: Look through the doorway"

#: scripts/campaign.gd:808
msgid "Raven: Shadepi am Sessel prüfen"
msgstr "Raven: Check on Shadepi in the chair"

#: scripts/campaign.gd:810
msgid "Raven: Zugangscode entschlüsseln"
msgstr "Raven: Decode the access code"

#: scripts/campaign.gd:813
msgid "Raven: Prüf-ICE per Matrix umgehen"
msgstr "Raven: Bypass the verification ICE with the matrix"

#: scripts/campaign.gd:816
msgid "Biometrie-Log der Landung fälschen"
msgstr "Forge the landing biometrics log"

#: scripts/campaign.gd:816
msgid "Penthouse-Tür öffnen · Tarnung bereit"
msgstr "Open the penthouse door · cloak ready"

#: scripts/campaign.gd:821
msgid "Kenzō · %d / 360 HP%s"
msgstr "Kenzō · %d / 360 HP%s"

#: scripts/campaign.gd:823
msgid "Waldweg · Mit Raven reden"
msgstr "Forest path · Talk to Raven"

#: scripts/campaign.gd:823
msgid "Unter den alten Bäumen"
msgstr "Beneath the ancient trees"

#: scripts/campaign.gd:823
msgid "Heiligtum am Waldweg hören"
msgstr "Listen to the Sanctuary along the forest path"

#: scripts/campaign.gd:823
msgid "Am See · Aufnahme und Kuss"
msgstr "At the lake · Initiation and kiss"

#: scripts/campaign.gd:825
msgid "Zum Aerodyne · Abflug"
msgstr "To the Aerodyne · Takeoff"

#: scripts/campaign.gd:826
msgid "Daten gesichert · Kenzō stellen"
msgstr "Data secured · Confront Kenzō"

#: scripts/campaign.gd:827
msgid "%s · %02d s"
msgstr "%s · %02d s"

#: scripts/campaign.gd:827
msgid "Raven schützen"
msgstr "Protect Raven"

#: scripts/campaign.gd:827
msgid "Sperrladung synchronisieren"
msgstr "Synchronize the blocking charge"

#: scripts/campaign.gd:827
msgid "Treibstoffpumpe fernstarten"
msgstr "Remote-start the fuel pump"

#: scripts/campaign.gd:827
msgid "Zum Dachausgang"
msgstr "To the roof exit"

#: scripts/campaign.gd:834
msgid "E / A · Flimmerndes Echo prüfen"
msgstr "E / A · Examine the flickering echo"

#: scripts/campaign.gd:840 scripts/campaign.gd:847 scripts/chapter_two.gd:254 scripts/main.gd:954
msgid "E / A · "
msgstr "E / A · "

#: scripts/campaign.gd:844
msgid "E / A · Ravens Terminal öffnen"
msgstr "E / A · Open Raven's terminal"

#: scripts/campaign.gd:846
msgid "E / A · Daten abgreifen"
msgstr "E / A · Extract data"

#: scripts/campaign.gd:846 scripts/chapter_two.gd:253
msgid "ICE scannt · auf Cyan warten"
msgstr "ICE scanning · wait for cyan"

#: scripts/campaign.gd:858 scripts/campaign.gd:894
msgid "NEON KOMBAT spielen"
msgstr "Play NEON KOMBAT"

#: scripts/campaign.gd:859
msgid "Klingen ansehen"
msgstr "Inspect the blades"

#: scripts/campaign.gd:859
msgid "Ersatzteile ansehen"
msgstr "Inspect the spare parts"

#: scripts/campaign.gd:859
msgid "Aerodyne ansehen"
msgstr "Inspect the Aerodyne"

#: scripts/campaign.gd:879
msgid "Das Bild zerfällt. Zur letzten stabilen Erinnerung."
msgstr "The image is falling apart. Back to the last stable memory."

#: scripts/campaign.gd:890
msgid "Das Kloster brennt noch immer in ihm."
msgstr "The monastery is still burning inside him."

#: scripts/campaign.gd:890
msgid "Shame Lys Opfer."
msgstr "Shame Ly's sacrifice."

#: scripts/campaign.gd:890
msgid "Das Vermächtnis."
msgstr "The legacy."

#: scripts/campaign.gd:898
msgid " · Bestände des Ordens."
msgstr " · The Order's supplies."

#: scripts/campaign.gd:914
msgid "Zugriff blockiert. Warte auf das Cyan-Signal."
msgstr "Access blocked. Wait for the cyan signal."

#: scripts/campaign.gd:924
msgid "Aufzug: Sicherheitskräfte eine Etage tiefer."
msgstr "Elevator: security forces one floor below."

#: scripts/campaign.gd:924
msgid "Dachzugang: privater Landeplatz."
msgstr "Roof access: private landing pad."

#: scripts/campaign.gd:924
msgid "Scanner: Kennung von Kenzōs Gleiter erforderlich."
msgstr "Scanner: Kenzō's aircraft ID required."

#: scripts/campaign.gd:928
msgid "Stromversorgung aktiv."
msgstr "Power supply active."

#: scripts/campaign.gd:928
msgid "Kennung kopiert."
msgstr "ID copied."

#: scripts/campaign.gd:928
msgid "Aerodyne gangbar. Noch die Prüf-ICE am Transponder umgehen."
msgstr "The Aerodyne is operational. Still need to bypass the transponder's verification ICE."

#: scripts/campaign.gd:930
msgid "Daten gesichert. Spuren gelöscht."
msgstr "Data secured. Traces erased."

#: scripts/campaign.gd:930
msgid "Raven: Sperrladung scharf. Aufzug blockiert."
msgstr "Raven: Blocking charge armed. Elevator sealed."

#: scripts/campaign.gd:930
msgid "Fernstart bestätigt. Zum Dachausgang!"
msgstr "Remote start confirmed. To the roof exit!"

#: scripts/campaign.gd:930
msgid "Raven: Raus hier! Durch die Lobby zum Landeplatz – da stehen noch Wachen."
msgstr "Raven: Let's get out of here! Through the lobby to the landing pad – there are still guards out there."

