msgstr "ID ACCEPTED"

#: scripts/aerodyne_flight.gd:463
msgid "TOWER: Gleiter Moriyama-01 erkannt. Landeplattform frei. – RAVEN: Wir sind drin."
msgstr "TOWER: Moriyama-01 identified. Landing platform clear. – RAVEN: We're in."

#: scripts/aerodyne_flight.gd:472
msgid "KENNUNG ABGELEHNT · ALARM"
msgstr "ID REJECTED · ALARM"

#: scripts/aerodyne_flight.gd:473
msgid "RAVEN: Abgelehnt! Weich den Lasern aus – beim nächsten Scannerdurchlauf versuche ich es neu."
msgstr "RAVEN: Rejected! Dodge the lasers – I'll try again on the next scan."

#: scripts/aerodyne_flight.gd:505
msgid "SHADEPI: Landeanflug. Schatten in den Ring – J / X hält die Bremsdüsen."
msgstr "SHADEPI: Landing approach. Shadow in the ring – hold J / X for braking thrusters."

#: scripts/aerodyne_flight.gd:538
msgid "DANEBEN · DURCHSTARTEN!"
msgstr "MISSED · GO AROUND!"

#: scripts/aerodyne_flight.gd:544
msgid "präzise"
msgstr "precise"

#: scripts/aerodyne_flight.gd:549
msgid "sehr hart"
