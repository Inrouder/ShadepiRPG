#: scripts/aerodyne_flight.gd:275
msgid "RAVEN: Turmabwehr! Laser-Drohnen – die roten Linien zeigen, wo sie feuern."
msgstr "RAVEN: Tower defenses! Laser drones – the red lines show where they'll fire."

#: scripts/aerodyne_flight.gd:280
msgid "VERSTÄRKUNG · DRITTE DROHNE"
msgstr "REINFORCEMENTS · THIRD DRONE"

#: scripts/aerodyne_flight.gd:281
msgid "RAVEN: Sie schicken eine dritte. Bleib in Bewegung, gleich sind wir am Scanner!"
msgstr "RAVEN: They're sending a third one. Keep moving, we're almost at the scanner!"

#: scripts/aerodyne_flight.gd:292
msgid "DRIFTKURVE · LEERTASTE / B"
msgstr "DRIFT TURN · SPACE / B"

#: scripts/aerodyne_flight.gd:317
