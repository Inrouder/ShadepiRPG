; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shadepi - Echos in Neon"
config/version="0.68.0"
run/main_scene="res://scenes/startup.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/branding/game-logos.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

AudioSettings="*res://scripts/audio_settings.gd"

DisplaySettings="*res://scripts/display_settings.gd"
NetworkSession="*res://scripts/network_session.gd"
MobileControls="*res://scripts/mobile_controls.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"
window/handheld/orientation=0

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.075, 1)
2d/snap/snap_2d_transforms_to_pixel=true
